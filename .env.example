# Database
DATABASE_URL=postgresql://tsio_hub_app:devpassword@db:5432/tsio_hub
DATABASE_ADMIN_URL=postgresql://postgres:REPLACE_WITH_ADMIN_PASSWORD@db:5432/tsio_hub

# Authentication (TBD — identity system pending discovery)
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
AUTH_PROVIDER_URL=https://REPLACE_WITH_OIDC_PROVIDER_URL
ENABLE_DEV_AUTH_BYPASS=false   # MUST be false in production (SEC-09)

# Email routing
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASS
EMAIL_ROUTING_MODE=smtp         # smtp | mailto
ENABLE_CAPTCHA_BYPASS=false    # MUST be false in production (SEC-09)

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://REPLACE_WITH_DEPLOYMENT_URL
RATE_LIMIT_STORE=memory        # memory | redis
REDIS_URL=                     # required if RATE_LIMIT_STORE=redis
