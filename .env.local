# Local development overrides — higher priority than .env
# These settings enable the dev auth bypass for local testing

# Database — use localhost for local dev (not the compose service name)
DATABASE_URL=postgresql://tsio_hub_app:devpassword@localhost:5432/tsio_hub
DATABASE_ADMIN_URL=postgresql://postgres:devpassword_admin@localhost:5432/tsio_hub

# Auth — enable dev bypass for local development
ENABLE_DEV_AUTH_BYPASS=true
NODE_ENV=development
